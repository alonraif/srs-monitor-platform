# SRS Monitor Platform environment template
# Copy to .env and adjust values for your deployment.

# =========================
# Core Mode
# =========================
# true: backend serves mock telemetry
# false: backend polls live SRS API
MOCK_MODE=true

# =========================
# Network Ports (host publish)
# =========================
SRS_RTMP_PORT=1935
SRS_SRT_PORT=10080
SRS_HTTP_PORT=8080
SRS_API_PORT=1985
BACKEND_PORT=8000
FRONTEND_PORT=3000
PREVIEW_PORT=8001
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081

# =========================
# SRS API and Playback Base URLs
# =========================
# Backend to SRS control-plane API
SRS_API_URL=http://srs:1985
SRS_API_TIMEOUT_SECONDS=2.5

# Public browser-facing playback base URLs
SRS_PUBLIC_HTTP_BASE_URL=http://localhost:8080
SRS_PUBLIC_WEBRTC_BASE_URL=webrtc://localhost

# Internal HTTP base URL used by backend/server-side resolution
SRS_INTERNAL_HTTP_BASE_URL=http://srs:8080

# =========================
# SRS HTTP API Authentication (Phase 2)
# =========================
# Used by secure SRS template overlays:
# deploy/compose/docker-compose.phase2.*.yml
SRS_HTTP_API_USERNAME=monitor
SRS_HTTP_API_PASSWORD=change-me-now
SRS_SRT_PASSPHRASE=change-me-srt-passphrase
SRS_SRT_PBKEYLEN=16
SRS_HOOK_SHARED_SECRET=dev-hook-secret
SRS_HOOK_ON_PUBLISH_URL=http://monitor-backend:8000/internal/srs/on_publish?secret=dev-hook-secret
SRS_HOOK_ON_PLAY_URL=http://monitor-backend:8000/internal/srs/on_play?secret=dev-hook-secret

# Used by backend SRS client for basic auth
# Keep these aligned with SRS_HTTP_API_* when auth is enabled on SRS.
SRS_API_USERNAME=
SRS_API_PASSWORD=

# =========================
# Preview Resolution and Service
# =========================
PREVIEW_PREFERRED_PROTOCOL=webrtc
PREVIEW_FORCE_REWRAP=false

# Public URL for preview playback links returned to browser
PREVIEW_PUBLIC_BASE_URL=http://localhost:8001

# Backend to preview-service internal URL
PREVIEW_SERVICE_URL=http://preview-service:8001

# Shared bearer token for backend <-> preview-service API auth
# If empty, preview-service auth is disabled.
PREVIEW_AUTH_TOKEN=

# =========================
# Backend API Authentication (Phase 2)
# =========================
# When true, backend enforces API keys on /api/* except /api/health
BACKEND_API_AUTH_ENABLED=false

# Read key for GET/HEAD/OPTIONS (Bearer token or X-API-Key)
BACKEND_READ_API_KEY=

# Write key for POST/PUT/PATCH/DELETE
# If empty, write methods fall back to BACKEND_READ_API_KEY.
BACKEND_WRITE_API_KEY=
STREAM_AUTH_ENFORCE=false
STREAM_AUTH_SECRET=change-stream-auth-secret
STREAM_AUTH_CLOCK_SKEW_SECONDS=60
EXPECTED_STREAM_SECRET_KEY=change-expected-stream-secret-key

# =========================
# CORS
# =========================
# Comma-separated exact origins for browser API requests.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex allowlist. Leave empty in production for strict origin control.
CORS_ALLOW_ORIGIN_REGEX=

# =========================
# Backend Storage
# =========================
SQLITE_PATH=/data/monitor.db

# =========================
# Stream Probe / Enrichment
# =========================
FFPROBE_ENABLED=true
FFPROBE_TIMEOUT_SECONDS=2.5
FFPROBE_CACHE_TTL_SECONDS=10

# =========================
# Frontend Runtime Variables (Vite)
# =========================
# Leave empty to use same-origin /api when served behind reverse proxy.
VITE_BACKEND_API_URL=

# Optional bearer key injected by frontend for backend API auth.
# For Phase 2 with UI access enabled, set this to BACKEND_READ_API_KEY
# (or a dedicated read token accepted by backend).
VITE_BACKEND_API_KEY=

# Frontend-visible ingest and playback hints
VITE_SRS_RTMP_PORT=1935
VITE_SRS_SRT_PORT=10080
VITE_SRS_PUBLIC_HTTP_BASE_URL=http://localhost:8080
VITE_SRS_PUBLIC_WEBRTC_BASE_URL=webrtc://localhost

# Browser-visible SRS WebRTC API base (for /rtc/v1/play/ flows).
# In single-host Phase 1/2, prefer proxy path to avoid exposing :1985.
VITE_SRS_WEBRTC_API_BASE_URL=/srs-api
